# Copy this file to .env and fill in values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Default: local SQLite file, zero setup. See ARCHITECTURE.md §5 for the
# Postgres migration path (docker-compose.yml ships a postgres service).
DATABASE_URL="file:./prisma/dev.db"

# --- Auth ---------------------------------------------------------------
# Single-user dashboard login. Set a real password hash via `npm run auth:set-password`.
AUTH_USER_EMAIL="you@example.com"
AUTH_PASSWORD_HASH=""
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption ---------------------------------------------------------
# 32-byte hex key used to encrypt sensitive candidate fields (work authorization,
# compensation) at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- AI provider (brief §31 — must not hardcode a single provider) ----------
# One of: openai | anthropic | null
# "null" uses the deterministic template fallback (no API key needed) so the
# app is fully runnable offline; set a real provider + key for higher-quality
# generation.
AI_PROVIDER="null"
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Notifications (optional, brief §26) ------------------------------------
NOTIFY_SLACK_WEBHOOK_URL=""
NOTIFY_TELEGRAM_BOT_TOKEN=""
NOTIFY_TELEGRAM_CHAT_ID=""
NOTIFY_EMAIL_FROM=""
NOTIFY_EMAIL_SMTP_URL=""

# --- Browser automation (brief §15) ------------------------------------
# Set to "true" to allow the Playwright automation agent to run at all.
# Even when true, submission still stops at the approval checkpoint unless
# Settings.approvalMode = AUTO and the per-application rules are satisfied.
AUTOMATION_ENABLED="false"
PLAYWRIGHT_HEADLESS="true"

# --- Dev/demo only (see README "Trying it without any real company boards
# configured") — never enable this in a real deployment. ---------------------
MOCK_SOURCE_ENABLED="false"
