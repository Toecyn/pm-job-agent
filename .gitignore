# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local/embedded Postgres data (npm run db:local-postgres, and the test suite's instance)
.local-postgres/
.test-postgres-data/

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
/screenshots/agent-runs/

# generated docs snapshot (not used — bundled node_modules docs are the source)
.next-docs/

# typescript
*.tsbuildinfo
next-env.d.ts
